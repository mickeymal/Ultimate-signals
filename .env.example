# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID or channel (e.g. @mychannel or -1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here

# Groq API key — FREE at console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_key_here

# Only send signals when AI confidence is at or above this % (default 50)
CONFIDENCE_THRESHOLD=50

# Only analyse markets expiring within this many days
MAX_DAYS_TO_EXPIRY=7

# How often to run a full scan in minutes
SCAN_INTERVAL_MINUTES=60

# Minimum market liquidity in USD (filters out thin/dead markets)
MIN_LIQUIDITY=500

# Max markets to run AI analysis on per scan (cost control)
MAX_ANALYSIS_PER_SCAN=300
