# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=your_chat_id_here

# Signal thresholds (percentage 0-100)
# Markets below LOW_THRESHOLD or above HIGH_THRESHOLD will be flagged
LOW_THRESHOLD=5
HIGH_THRESHOLD=95

# How often to scan in minutes (default: 60)
SCAN_INTERVAL_MINUTES=60

# Minimum liquidity in USD to include a market (filters out dead markets)
MIN_LIQUIDITY=100
