# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID or channel (e.g. @mychannel or -1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here

# How often to scan for new short-term markets (minutes)
SCAN_INTERVAL_MINUTES=5

# Only show markets expiring within this many days (1 = today only, 0.25 = next 6 hours)
MAX_DAYS_TO_EXPIRY=1

# Minimum market liquidity in USD
MIN_LIQUIDITY=100

# Top trader tracking
TOP_TRADERS_COUNT=25
TRACKER_POLL_MINUTES=3
